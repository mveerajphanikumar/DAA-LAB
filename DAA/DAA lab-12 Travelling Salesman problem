#include <iostream>
#include <vector>
#include <limits>
#include <algorithm>

using namespace std;

const long long INF = numeric_limits<long long>::max() / 4;

// Travelling Salesman Problem using Dynamic Programming
void travellingSalesman(const vector<vector<long long>>& cost, int n)
{
    if (n > 18)
    {
        cout << "Maximum supported cities: 18.\n";
        return;
    }

    int totalMasks = 1 << n;
    int fullMask = totalMasks - 1;

    vector<vector<long long>> dp(
        totalMasks, vector<long long>(n, INF)
    );

    vector<vector<int>> parent(
        totalMasks, vector<int>(n, -1)
    );

    // Start from city 1 (index 0)
    dp[1][0] = 0;

    // Process all subsets of visited cities
    for (int mask = 1; mask < totalMasks; mask++)
    {
        if ((mask & 1) == 0)
            continue;

        for (int u = 0; u < n; u++)
        {
            if (dp[mask][u] == INF)
                continue;

            for (int v = 1; v < n; v++)
            {
                if (mask & (1 << v))
                    continue;

                if (cost[u][v] == -1)
                    continue;

                int nextMask = mask | (1 << v);
                long long newCost = dp[mask][u] + cost[u][v];

                if (newCost < dp[nextMask][v])
                {
                    dp[nextMask][v] = newCost;
                    parent[nextMask][v] = u;
                }
            }
        }
    }

    // Return to the starting city
    long long minCost = INF;
    int lastCity = -1;

    for (int u = 1; u < n; u++)
    {
        if (dp[fullMask][u] == INF || cost[u][0] == -1)
            continue;

        long long tourCost = dp[fullMask][u] + cost[u][0];

        if (tourCost < minCost)
        {
            minCost = tourCost;
            lastCity = u;
        }
    }

    if (lastCity == -1)
    {
        cout << "No complete tour exists.\n";
        return;
    }

    // Reconstruct the optimal tour
    vector<int> path;
    int mask = fullMask;
    int current = lastCity;

    while (current != 0)
    {
        path.push_back(current);

        int previous = parent[mask][current];
        mask ^= (1 << current);
        current = previous;
    }

    reverse(path.begin(), path.end());

    cout << "\nMinimum Tour Cost: " << minCost << '\n';
    cout << "Optimal Tour: 1";

    for (int city : path)
        cout << " -> " << city + 1;

    cout << " -> 1\n";
}

int main()
{
    int n;

    cout << "Enter number of cities (2-18): ";
    cin >> n;

    if (!cin || n < 2 || n > 18)
    {
        cout << "Invalid number of cities.\n";
        return 1;
    }

    vector<vector<long long>> cost(
        n, vector<long long>(n)
    );

    cout << "Enter the cost matrix (-1 for no route):\n";
    cout << "Use 0 on the diagonal.\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> cost[i][j];

            if (!cin)
            {
                cout << "Invalid matrix input.\n";
                return 1;
            }

            if (i == j)
                cost[i][j] = 0;
        }
    }

    travellingSalesman(cost, n);

    return 0;
}
